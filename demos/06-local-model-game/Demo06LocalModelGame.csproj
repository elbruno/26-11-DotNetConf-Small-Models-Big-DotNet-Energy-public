<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ValidateGame" />
    <Content Include="assets\sprites\*.png" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="ElBruno.AI.Decisions.Ollama" Version="0.6.3" />
    <PackageReference Include="Microsoft.AI.Foundry.Local" Version="2.2.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
